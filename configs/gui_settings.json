{
  "logger": {
    "poll_interval_ms": 1000,
    "queue_depth": 50000,
    "worker_threads": 2,
    "stats_interval_ms": 1000
  },
  "duts": [
    {
      "name": "gui-demo-dut",
      "dut_ip": "127.0.0.1",
      "enabled": true,
      "snmp": {
        "mode": "stub",
        "version": "2c",
        "community": "public",
        "port_number": 161
      },
      "metrics": [
        {
          "name": "sysUpTime",
          "oid": "1.3.6.1.2.1.1.3.0",
          "operation": "get"
        },
        {
          "name": "cpuLoad",
          "oid": "1.3.6.1.4.1.2021.10.1.3.1",
          "operation": "get"
        }
      ]
    }
  ],
  "sinks": [
    {
      "type": "sqlite3",
      "enabled": true,
      "path": "./data/gui_demo.sqlite"
    }
  ],
  "gui": {
    "frontend": "web",
    "host": "127.0.0.1",
    "port": 8765,
    "theme": "light",
    "window_width": 1280,
    "window_height": 820,
    "refresh_interval_ms": 750,
    "open_browser": true,
    "cli_executable": "",
    "max_log_lines": 500
  }
}
