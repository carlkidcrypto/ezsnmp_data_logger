{
  "name": "ezsnmp-data-logger",
  "version": "2026.11.1-alpha.0",
  "description": "Self-contained Node.js N-API bindings for the C++17 ezsnmp_data_logger engine",
  "license": "MIT",
  "main": "index.js",
  "files": [
    "index.js",
    "build/Release/ezsnmp_data_logger.node",
    "build/Release/.dylibs/**",
    "build/Release/libs/**",
    "build/Release/*.dll"
  ],
  "scripts": {
    "prepare-deps": "python3 ../../tools/prepare_sqlite3_amalgamation.py && python3 ../../tools/prepare_ezsnmp_source.py",
    "generate-swig": "python3 ../../tools/generate_swig_bindings.py --languages javascript --output-dir ./generated",
    "bundle-native": "python3 ../../tools/bundle_native_package.py ./build/Release/ezsnmp_data_logger.node",
    "build": "npm run prepare-deps && npm run generate-swig && node-gyp rebuild && npm run bundle-native"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0"
  }
}
